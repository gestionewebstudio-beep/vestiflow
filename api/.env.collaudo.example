# ⭐ AMBIENTE DEL COLLAUDO REALE SHOPIFY (`docs/28`) — modello SENZA valori.
#
# Copia questo file in `api/.env.collaudo.local` (ignorato da Git: `.env.*.local`)
# e compila i valori. ⛔ Non è `api/.env`: l'istanza del collaudo legge SOLO il
# file che le viene dichiarato (`VESTIFLOW_ENV_FILE`), e le sue destinazioni si
# verificano prima dell'avvio con `npm run env:destinazioni api/.env.collaudo.local`.
#
# Chi compila che cosa: il titolare mette i valori segreti dell'app Shopify del
# collaudo e di Supabase; il resto è già scritto qui e non è segreto.

# ── Database del collaudo: PostgreSQL locale in Docker (docker-compose.collaudo.yml) ──
# 5434, non 5433 (TEST delle suite) né 5432. `prisma:deploy:collaudo` rifiuta
# qualunque altro bersaglio. Valori NON segreti: container locale, usa-e-getta.
DATABASE_URL=postgresql://vestiflow:vestiflow_collaudo_local@localhost:5434/vestiflow_collaudo
DIRECT_URL=postgresql://vestiflow:vestiflow_collaudo_local@localhost:5434/vestiflow_collaudo

# ── Porta dell'API del collaudo: 3100, non 3000 (l'API di sviluppo del titolare) ──
PORT=3100

# ── Supabase: lo STESSO progetto per l'AUTENTICAZIONE (gli utenti di prova esistono già).
# ⚠️ Nessuna tabella del condiviso viene letta o scritta: il database è quello sopra.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Storage: bucket DEDICATI al collaudo, così le immagini e gli allegati del
# collaudo non entrano nei bucket di sviluppo. L'API li crea se mancano
# (`attachment-storage.util`): è l'unica scrittura sul progetto Supabase, dichiarata.
SUPABASE_PRODUCT_MEDIA_BUCKET=collaudo-product-media
SUPABASE_USER_AVATARS_BUCKET=collaudo-user-avatars
SUPABASE_DOCUMENT_ATTACHMENTS_BUCKET=collaudo-document-attachments
SUPABASE_SUPPLIER_ATTACHMENTS_BUCKET=collaudo-supplier-attachments

# ── Frontend del collaudo: porta 4212 (`npm run start:collaudo`), non 4200 ──
FRONTEND_URL=http://localhost:4212
CORS_ORIGINS=http://localhost:4212

# ── Shopify: l'APP SEPARATA del collaudo (Partner dashboard), non quella di produzione ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders,read_customers,read_inventory,write_inventory,read_locations,read_products,write_products,read_metaobject_definitions,write_metaobjects,read_publications,write_publications,read_merchant_managed_fulfillment_orders
# L'URL PUBBLICO del tunnel verso localhost:3100 (cloudflared/ngrok): lo stesso
# registrato nell'app Shopify come App URL e URL di ritorno. Senza, i webhook
# veri non arrivano — e il collaudo della ricezione automatica non esiste.
SHOPIFY_APP_URL=
# Chiave per cifrare i token a riposo. ⭐ Con una COPIA ripristinata dal condiviso di prova, usare
# una chiave NUOVA rende illeggibile ogni token copiato (anche quello del negozio del collaudo):
# è una seconda barriera oltre a `collaudo:isola-copia`, e il negozio del collaudo si ricollega
# via OAuth dal collaudo — che è comunque il passo che registra i webhook verso il tunnel.
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# ── Amministratori di piattaforma: gli stessi indirizzi di prova ──
PLATFORM_ADMIN_EMAILS=

# ── Backup: fuori dal collaudo. Nessuna passphrase qui. ──

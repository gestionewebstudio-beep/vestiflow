{
  "name": "vestiflow",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:api": "npm run start:dev --prefix api",
    "start:dev": "npm run start:dev --prefix api",
    "build": "ng build",
    "build:firebase": "node scripts/generate-environment-prod.mjs && ng build",
    "build:pwa": "ng build --configuration=production",
    "build:pwa:local": "ng build --configuration=pwa-local",
    "serve:pwa": "npx http-server dist/vestiflow/browser -p 4200 -c-1",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --coverage=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage --exclude \"**/*.component.spec.ts\"",
    "test:components": "ng test --watch=false --include \"**/*.component.spec.ts\" --coverage=false",
    "test:api": "npm run test --prefix api",
    "test:integration": "npm run test:integration --prefix api",
    "provision:e2e-users": "npm run provision:e2e-users --prefix api",
    "test:everything": "npm run test:coverage && npm run test:components && npm run test:api",
    "test:all": "npm run test:everything",
    "test:coverage:all": "npm run test:coverage && npm run test:components && npm run test:coverage --prefix api",
    "test:coverage:check": "npm run test:coverage:all",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headless": "playwright test",
    "e2e:ci": "playwright test --project=chromium-guest --project=chromium-ci",
    "e2e:authenticated": "playwright test --project=setup --project=chromium --project=mobile-chrome",
    "e2e:guest": "playwright test --project=chromium-guest",
    "lint": "ng lint && npm run lint:api && npm run check:tokens && npm run check:subscriptions && npm run check:table-views && npm run check:permissions && npm run check:endpoint-gates && npm run check:form-errors && npm run check:print-types && npm run check:registro && npm run check:terminologia && npm run check:modalita-prezzo && npm run check:tab-stops && npm run check:sort-columns && npm run check:search-config && npm run check:variant-label && npm run check:column-handles && npm run check:document-grammar && npm run check:exit-label && npm run check:exit-dialog && npm run check:document-actions && npm run check:page-state && npm run check:money-input && npm run check:nome-fattura && npm run check:header-groups && npm run check:decoratori-orfani && npm run check:dto-decimali && npm run check:location-scope && npm run check:router-links && npm run check:column-gates",
    "lint:fix": "ng lint --fix",
    "lint:api": "npm run lint --prefix api",
    "audit:lhci": "lhci autorun",
    "check:rls": "node scripts/check-rls.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:subscriptions": "node scripts/check-subscriptions.mjs",
    "check:table-views": "node scripts/check-table-views.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:endpoint-gates": "node scripts/check-endpoint-gates.mjs",
    "check:form-errors": "node scripts/check-form-errors.mjs",
    "check:print-types": "node scripts/check-print-types.mjs",
    "backup:full": "node scripts/backup/run-backup.mjs",
    "backup:db": "node scripts/backup/run-backup.mjs --db-only",
    "backup:storage": "node scripts/backup/run-backup.mjs --storage-only",
    "backup:restore": "node scripts/backup/run-restore.mjs",
    "docs:guide": "node scripts/generate-guide-html.mjs",
    "docs:guide:pdf": "node scripts/generate-guide-pdf.mjs",
    "docs:guide:all": "npm run docs:guide && npm run docs:guide:pdf",
    "docs:test-plan": "node scripts/generate-test-plan-html.mjs",
    "docs:test-plan:pdf": "node scripts/generate-test-plan-pdf.mjs",
    "docs:test-plan:all": "npm run docs:test-plan && npm run docs:test-plan:pdf",
    "docs:infra-costs": "node scripts/generate-infra-costs-html.mjs",
    "docs:infra-costs:pdf": "node scripts/generate-infra-costs-pdf.mjs",
    "docs:infra-costs:all": "npm run docs:infra-costs && npm run docs:infra-costs:pdf",
    "icons:generate": "node scripts/generate-icons.mjs",
    "prepare": "husky",
    "check:registro": "node scripts/check-registro-legacy.mjs",
    "check:terminologia": "node scripts/check-terminologia.mjs",
    "check:modalita-prezzo": "node scripts/check-modalita-prezzo.mjs",
    "check:api-boot": "node scripts/check-api-boot.mjs",
    "check:tab-stops": "node scripts/check-tab-stops.mjs",
    "check:sort-columns": "node scripts/check-sort-columns.mjs",
    "check:search-config": "node scripts/check-search-config.mjs",
    "check:column-handles": "node scripts/check-column-handles.mjs",
    "check:variant-label": "node scripts/check-variant-label.mjs",
    "check:document-grammar": "node scripts/check-document-grammar.mjs",
    "check:exit-label": "node scripts/check-exit-label.mjs",
    "check:exit-dialog": "node scripts/check-exit-dialog.mjs",
    "check:document-actions": "node scripts/check-document-actions.mjs",
    "check:money-input": "node scripts/check-money-input.mjs",
    "check:nome-fattura": "node scripts/check-nome-fattura.mjs",
    "check:page-state": "node scripts/check-page-state.mjs",
    "check:header-groups": "node scripts/check-header-groups.mjs",
    "check:decoratori-orfani": "node scripts/check-decoratori-orfani.mjs",
    "check:dto-decimali": "node scripts/check-dto-decimali.mjs",
    "check:location-scope": "node scripts/check-location-scope.mjs",
    "check:router-links": "node scripts/check-router-links.mjs",
    "check:column-gates": "node scripts/check-column-gates.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.13.0 <23.0.0"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "esbuild": "^0.28.1",
    "vite": "^7.3.5",
    "piscina": "5.2.0",
    "undici": "7.29.0",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@angular/service-worker": "^21.2.19",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@supabase/supabase-js": "^2.108.1",
    "barcode-detector": "^3.2.1",
    "chart.js": "^4.5.1",
    "jsbarcode": "^3.12.3",
    "ng2-charts": "^10.0.0",
    "primeicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@testing-library/angular": "^19.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.4.0",
    "marked": "^15.0.12",
    "marked-gfm-heading-id": "^4.1.4",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "e2e/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "playwright.config.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,yaml,yml}": [
      "prettier --write"
    ]
  },
  "volta": {
    "node": "22.13.1"
  }
}

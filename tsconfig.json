/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
/* ⛔ QUESTO FILE NON CONTROLLA NIENTE, ed è voluto: `"files": []` più
   `references` è la forma dei progetti compositi. `tsc --noEmit -p tsconfig.json`
   compila ZERO file e risponde «nessun errore» — misurato il 29/08/2026, dopo
   che quel comando aveva dichiarato «tipi puliti» su un frontend che ne aveva
   sette. Il controllo vero è  npm run check:types  (o `npm run build`). */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    /* La lib completa di ES2022 (quella implicita del target) più i TIPI di
       `Intl` di ES2023: servono per `useGrouping: 'always'` in `formatMoney`
       (il punto delle migliaia anche a quattro cifre, 13/09/2026). Solo tipi:
       il runtime lo hanno tutti i browser che Angular 20 supporta. */
    "lib": [
      "ES2022",
      "ES2023.Intl",
      "DOM",
      "WebWorker.ImportScripts",
      "ScriptHost",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "module": "preserve",
    "paths": {
      "@core/*": ["./src/app/core/*"],
      "@domain/*": ["./src/app/domain/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@features/*": ["./src/app/features/*"],
      "@env/*": ["./src/environments/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./e2e/tsconfig.json"
    }
  ]
}
